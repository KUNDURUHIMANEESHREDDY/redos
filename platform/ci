## Kubernetes Integration

### Operator CRDs (Custom Resource Definitions)

#### RedOSSecurityScan CRD
```yaml
apiVersion: redos.io/v1
kind: RedOSSecurityScan
metadata:
  name: pr-scan
spec:
  pull_request_number: 123
  organization_id: org_oid
  auto_block_on_critical: true
  auto_warn_on_medium_increase: true
  medium_increase_threshold: 5
  medium_increase_window_days: 30
  gate_evaluation: true
  upload_findings: true
  alert_on_block: true
```

#### RedOS

#### RedOSGateConfig CRD
```yaml
apiVersion: redos.io/v1
kind: RedOSGateConfig
metadata:
  name: organization-gates
spec:
  organization_id: org_oid
  gates:
    BLOCK_CRITICAL:
      enabled: true
      severity: "CRITICAL"
      action: "block"
    BLOCK_HIGH_INTRO:
      enabled: true
      hours_window: 24
      action: "block"
    WARN_MEDIUM_INCREASE:
      enabled: true
      threshold: 5
      window_days: 30
      action: "warn"
    PASS_NO_REGRESSION:
      enabled: true
    PASS_COMPLIANCE:
      enabled: false
```

### Kubernetes Operator

```go
// Pseudocode - RedOS Gate Admission Controller
package redos

import (
    "context"
    corev1 "k8s.io/api/core/v1"
    metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
    redos "redos.io/api/v1"
)

type GateDecision struct {
    FinalDecision  string                    `json:"finalDecision"`
    Results        map[string]GateResult    `json:"results"`
    DecisionReason string                   `json:"decisionReason"`
}

type GateResult struct {
    Result      string   `json:"result"`
    Triggered   bool     `json:"triggered"`
    Details     string   `json:"details"`
}

func (r *RedOSReconciler) evaluateGates(ctx context.Context, pr *corev1.PullRequest) *GateDecision {
    // Pull gate config from RedOS API
    gates := r.fetchGateConfig(pr.Annotations)
    
    // Evaluate each gate against findings
    decisions := make(map[string]GateResult)
    
    // BLOCK_CRITICAL
    if gates.BLOCK_CRITICAL.Enabled {
        findings := r.findCriticalFindings(pr.Number)
        decisions["BLOCK_CRITICAL"] = GateResult{
            Result:      "block",
            Triggered:   len(findings) > 0,
            Details:     fmt.Sprintf("Critical findings: %d", len(findings)),
        }
    }
    
    // ... evaluate other gates
    
    // Determine final decision
    finalDecision := "pass"
    reason := ""
    for _, d := range decisions {
        if d.Result == "block" {
            finalDecision = "block"
            reason = d.Details
            break
        } else if d.Result == "warn" && finalDecision != "block" {
            finalDecision = "warn"
            reason = d.Details
        }
    }
    
    return &GateDecision{
        FinalDecision:  finalDecision,
        Results:        decisions,
        DecisionReason: reason,
    }
}
```

### ArgoCD Integration

```yaml
# ArgoCD Application with gate evaluation
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: redos-security-scan
spec:
  source:
    repoURL: https://github.com/org/redos
    targetRevision: HEAD
    path: .
  destination:
    server: https://k8s.cluster.local
    namespace: redos
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace
  
  # Sync hook runs gate evaluation
  syncHook: |
    #!/bin/bash
    curl -X POST https://api.redos.io/api/v1/gates/evaluate \
      -H "Authorization: Bearer $REDOS_API_TOKEN" \
      -d '{"pull_request_number": "$ARGO_PR_NUMBER", "organization_id": "$ORG_ID"}'
```

## Docker Integration

### Docker Build Hooks

```dockerfile
# Dockerfile with RedOS security scanning
FROM node:20 AS builder

# ... build steps ...

# Security scan stage
FROM node:20 AS security-scan

# Install RedOS CLI
RUN npm install -g @redos/cli

# Run gates before final image
RUN redos-gates:evaluate \
  --api-url https://api.redos.io \
  --api-key $REDOS_API_KEY \
  --org-id $REDOS_ORG_ID \
  --pr-number ${GITHUB_PR_NUMBER:-0}

# If gates pass, continue to push
# If gates fail, build stops
```

### Docker Scout Integration

```bash
# Docker Scout + RedOS integration
docker scout cve-scan my-image:tag

# Upload results to RedOS
redos-cli upload --type scout --data scout-results.json

# Gate evaluation based on scout results
redos-cli gates:check --critical-threshold 0
```

